<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.cme.antigravity</groupId>
    <artifactId>Analizar_DAB</artifactId>
    <version>1.0</version>
    <packaging>jar</packaging>

    <name>Analizar DAB</name>
    <description>Plugin para medir área e intensidad de DAB (3,3'-Diaminobencidina) en imágenes IHC.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- "release" en vez de "source" y "target": asi el compilador
             no solo GENERA bytecode de Java 8 sino que ademas compila
             CONTRA la biblioteca de Java 8. Con source/target, un JDK
             moderno deja pasar llamadas a metodos que no existen en
             Java 8 y la falla recien aparece en la maquina del usuario. -->
        <maven.compiler.release>8</maven.compiler.release>
    </properties>

    <!-- Dependencies -->
    <dependencies>
        <!-- ImageJ / Fiji dependency -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <version>1.54f</version>
            <scope>provided</scope>
        </dependency>
        <!-- Apache POI para generar archivos .xlsx (se empaqueta dentro del JAR) -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.2.3</version>
            <scope>compile</scope>
        </dependency>
        <!-- Implementación de Log4j para evitar el error 'could not find a logging implementation' de POI -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <version>2.18.0</version>
            <scope>compile</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Shade plugin: empaqueta POI y sus dependencias dentro del JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.5.1</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <repositories>
        <repository>
            <id>imagej.public</id>
            <url>https://maven.imagej.net/content/groups/public</url>
        </repository>
    </repositories>

</project>
